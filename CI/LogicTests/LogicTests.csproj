<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the game's plain resource logic outside Unity, so CI can test it
    without a Unity install or licence. The real game files are compiled in
    directly; UnityStubs.cs stands in for the few UnityEngine types they use.
    CI runs it on every push; .github/workflows/ci.yml has the command to run it locally.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Match the C# version Unity compiles the game with. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/_Game/Scripts/Economy/ResourceType.cs" Link="Game/ResourceType.cs" />
    <Compile Include="../../Assets/_Game/Scripts/Economy/Inventory.cs" Link="Game/Inventory.cs" />
  </ItemGroup>

</Project>

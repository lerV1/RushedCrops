--- !u!114 &1216362676403454411
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5275655281901171325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 016f2f205765a6143a576aaa52167491, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MerchantPersonality
  animator: {fileID: 1485370935143592637}
  player: {fileID: 0}
  shop: {fileID: 0}
  speechBubble: {fileID: 8895178970076233445}
  speechText: {fileID: 645409779365571394}
  noticeDistance: 9
  greetDistance: 5
  greetCooldown: 30
  turnSpeed: 160
  speechSeconds: 3.5
  greetings:
  - Ah, a customer! Fresh seeds, fair prices... mostly.
  - Welcome, friend! My prices are the talk of the valley.
  - Back again? I knew you'd miss me.
  openingLines:
  - What'll it be?
  - Take your time. Prices only go up.
  - Everything you see is a bargain. For me.
  boughtLines:
  - A fine choice! Heh heh.
  - Pleasure doing business.
  - You won't find cheaper. Not around here, anyway.
  soldLines:
  - I'll take those off your hands.
  - Hmm, a bit bruised... but I'm feeling generous.
  - Lovely. These will fetch a fine... I mean, fair price.
  cantAffordLines:
  - No coin, no goods, friend.
  - Come back when your purse is heavier.
  noRoomLines:
  - Your pockets are full! Make some room first.
  farewells:
  - Come back soon! Prices may change... in my favour.
  - Off you go. Mind the evil vegetables.
